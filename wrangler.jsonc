{
  "name": "hyderabad-tech-week-site",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "hyderabadtechweek.com/*",
      "zone_name": "hyderabadtechweek.com"
    },
    {
      "pattern": "www.hyderabadtechweek.com/*",
      "zone_name": "hyderabadtechweek.com"
    }
  ],
  "main": "worker.js"
}
